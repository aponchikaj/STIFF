# Local: talk to the Nest server on this machine.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Production / Vercel: keep API calls first-party via the Next.js rewrite,
# and point the rewrite at the hosted Nest API.
# NEXT_PUBLIC_API_URL=/api
# BACKEND_URL=https://stiff-i3nq.onrender.com
# NEXT_PUBLIC_SITE_URL=https://stiff.ge

# The admin panel is its own deployment on its own origin, with its own
# sign-in. The "Admin panel" button on /account and the old /admin route both
# point here. Defaults to http://localhost:3002 in dev, https://admin.stiff.ge
# in production.
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
