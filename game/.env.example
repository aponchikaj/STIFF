# ---------------------------------------------------------------- local dev
# The Nest API, with its /api prefix. The backend's corsOrigins() must name
# this app's origin (http://localhost:3005) or every call is a CORS error
# that looks like the API is down.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ----------------------------------------------------------------- deployed
# Set BOTH of these together, or neither.
#
# BACKEND_URL makes next.config.ts rewrite /api/* through this origin, which
# keeps the session cookie first-party across stiff.co → stiff.ge. Setting it
# without pointing NEXT_PUBLIC_API_URL at the relative /api leaves the client
# still calling the API cross-site, and the rewrite does nothing.
#
# BACKEND_URL=https://stiff.ge
# NEXT_PUBLIC_API_URL=/api
