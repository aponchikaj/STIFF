# Database dumps taken before schema changes — real content, not source.
# These contain the users table; keep them off the laptop long-term.
# Take one with ./scripts/db-backup.sh
backups/
pg_dump_backup_*.sql
*.dump

# OS
.DS_Store

# Build output and dependencies.
#
# Each app has its own .gitignore, but those only exist on branches that carry
# the app — staff/ lives on `staff` alone. Ignoring here too means a checkout
# of main with a stale staff/ directory on disk cannot have its build output
# swept into a commit.
node_modules/
.next/
dist/

# Stale staff/, admin/ and game/ build leftovers from a checkout of one of
# those branches, on branches without the app.
staff/next-env.d.ts
staff/tsconfig.tsbuildinfo
admin/next-env.d.ts
admin/tsconfig.tsbuildinfo
game/next-env.d.ts
game/tsconfig.tsbuildinfo

# Sibling checkouts of the superset branches, so `admin` and `game` can run at
# the same time — a plain checkout of one deletes the other's app directory.
# Create with: git worktree add .worktrees/<branch> <branch>
.worktrees/
