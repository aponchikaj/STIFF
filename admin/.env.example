# Local: Nest on this machine. The admin panel is http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# The shop's origin — NOT this panel's. Collab QR codes are minted from it and
# then printed, so pointing this at the wrong environment is expensive to
# discover. Defaults to http://localhost:3000 in dev, https://stiff.ge in
# production. Set it explicitly on staging so staging mints staging codes.
# NEXT_PUBLIC_SHOP_URL=http://localhost:3000

# Production / Vercel: keep API calls first-party via the Next.js rewrite so
# the admin session cookie stays first-party, and point the rewrite at Nest.
# NEXT_PUBLIC_API_URL=/api
# BACKEND_URL=https://stiff-i3nq.onrender.com
# NEXT_PUBLIC_SHOP_URL=https://stiff.ge
