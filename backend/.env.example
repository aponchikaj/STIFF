NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:4000
# Production (Render): APP_URL=https://stiff-i3nq.onrender.com
#                      FRONTEND_URL=https://stiff.ge
# Absolute site URL used for links inside emails (falls back to FRONTEND_URL).
# Collab QR codes use the admin's current origin instead (stage vs production).
PUBLIC_SITE_URL=https://stiff.ge

# PostgreSQL connection (Supabase direct connection or local install)
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Schema changes run as migrations on boot. Set to false to boot without
# applying pending ones.
DB_MIGRATIONS_RUN=true

# Cookie policy: leave unset (lax) when the frontend proxies /api on its own
# domain or the API lives on a stiff.ge subdomain; set to `none` only if the
# backend is on a completely different domain (HTTPS required).
COOKIE_SAMESITE=

# JWT auth — generate long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encrypts unused collab QR tokens at rest so they can be reprinted.
# Falls back to JWT_ACCESS_SECRET if unset.
COLLAB_TOKEN_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Resend email (leave empty in dev — links are logged to the console instead)
RESEND_API_KEY=
MAIL_FROM="STIFF <onboarding@resend.dev>"

# Cloudinary image hosting (leave empty to store uploads on local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First shop admin account, seeded on startup
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Staff workspace (staff.stiff.ge) — separate people table, not shop users.
# Invite-only: nobody self-registers. This owner is seeded on boot.
STAFF_FRONTEND_URL=http://localhost:3001
STAFF_OWNER_USERNAME=
STAFF_OWNER_PASSWORD=
STAFF_OWNER_EMAIL=
STAFF_OWNER_INSTAGRAM=
# Optional extra JWT secrets so staff tokens cannot be confused with shop ones.
# STAFF_JWT_ACCESS_SECRET=
# STAFF_JWT_REFRESH_SECRET=
