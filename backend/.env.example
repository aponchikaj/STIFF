# backend/.env — copy to .env and fill in.
#
# Read by @nestjs/config at boot. Nothing here has a safe production default:
# where a fallback exists it is a local-development one, and shipping it is
# how a deploy ends up talking to localhost.

# ---------------------------------------------------------------- runtime --

NODE_ENV=development
PORT=4000

# This API's own public origin. Used in emailed links and in the local upload
# fallback's URLs, so a wrong value produces links that 404 for the customer
# rather than an error anyone sees.
APP_URL=http://localhost:4000

# --------------------------------------------------------------- database --
#
# Hosted Supabase Postgres, shared by local development and the deployed site.
# There is real content in it — treat every schema change as a production one
# and back up with pg_dump before structural work.

DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true

# Pending migrations run automatically on boot unless this is false.
# Set it to false locally: `npm run test:e2e` boots the app, and against the
# shared database that means an e2e run migrates production.
DB_MIGRATIONS_RUN=false

# ----------------------------------------------------------------- redis --
#
# Optional, and the app runs without it — but three things are only correct on
# a single instance while it is unset, and all three fail *quietly* when a
# second instance appears:
#
#   - rate limits are per-process, so N instances multiply every limit
#   - staff chat does not fan out; messages reach whoever shares the process
#   - every cron runs on every process, so scheduled side effects duplicate
#
# None of them throws. Set this before running more than one instance; the boot
# log says which mode the process is in.
#
# Upstash and any TLS Redis work: rediss://default:<token>@<host>:<port>
REDIS_URL=

# ------------------------------------------------------------------ CORS --
#
# The allowlist in `corsOrigins()`. The stiff.ge hosts are hardcoded; these
# four are what local development and any other environment use. Pinned by
# `configure-app.spec.ts` — widening the list should fail that test first.

FRONTEND_URL=http://localhost:3000
STAFF_FRONTEND_URL=http://localhost:3001
ADMIN_FRONTEND_URL=http://localhost:3002
GAME_FRONTEND_URL=http://localhost:3003

# ------------------------------------------------------------- sessions --
#
# Three audiences, one backend, and they are not interchangeable: a staff or
# admin token presented as a shop session is rejected even when the signing
# secret is shared. Give each its own secret in production.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# STAFF_JWT_ACCESS_SECRET=
# ADMIN_JWT_ACCESS_SECRET=

# Widens the session cookie to every stiff.ge subdomain, so a sign-in on
# stiff.ge is visible on game.stiff.ge. Leave unset locally — host-only
# cookies are the safer default and localhost has no subdomains to share with.
# Read auth.controller.ts and cookie-domain.spec.ts before setting it: it
# changes who can see an existing session.
# COOKIE_DOMAIN=.stiff.ge

# Comma-separated. When set, admin.stiff.ge requests from anywhere else are
# refused before the token is even checked.
# ADMIN_IP_ALLOWLIST=

# ------------------------------------------------------------ game media --
#
# Where a player's photo or clip is stored. S3-compatible: Cloudflare R2 is
# what `docs/game/hosting.md` costs out, and the signing is plain SigV4 so
# S3 itself works unchanged.
#
# The browser uploads straight here with a presigned PUT — media never passes
# through this app, which is the rule the whole media budget rests on. Unset,
# `MediaStorageService` refuses to sign anything and says so, rather than
# handing out URLs that cannot work.

# R2: https://<account-id>.r2.cloudflarestorage.com
GAME_MEDIA_ENDPOINT=
GAME_MEDIA_BUCKET=
GAME_MEDIA_ACCESS_KEY=
GAME_MEDIA_SECRET_KEY=

# R2 has one region and calls it `auto`. On S3, set the bucket's real region.
GAME_MEDIA_REGION=auto

# The CDN origin the finished object is served from — a custom domain in front
# of the bucket, never the signing endpoint. This is what ends up in the feed,
# so pointing it at the raw bucket URL bills egress on every view.
GAME_MEDIA_PUBLIC_URL=

# ---------------------------------------------------------------------- AI --
#
# Task generation (spec 11). Claude writes candidate task briefs; the exclusion
# screen in `game/ai/exclusions.ts` decides which survive, and nothing it writes
# is published without a staff verdict.
#
# Unset, generation is disabled and the endpoint says so. The rest of the game
# runs unaffected — the AI is additive, not load-bearing.

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- uploads --
#
# Shop images (products, gallery). Without all three, uploads fall back to
# local disk, which does not survive a Render deploy.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------ mail --

RESEND_API_KEY=
MAIL_FROM=STIFF <noreply@stiff.ge>

# -------------------------------------------------------------- payments --
#
# With this on, card orders are marked paid without money moving and the
# service logs a warning on every one. Never true in production.
PAYMENTS_TEST_MODE=true

# ------------------------------------------------------------------ seed --
#
# First-run accounts. Used once, at boot, when the table is empty.

ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

STAFF_OWNER_EMAIL=
STAFF_OWNER_USERNAME=
STAFF_OWNER_PASSWORD=
STAFF_OWNER_INSTAGRAM=
