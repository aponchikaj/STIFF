NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:4000

# PostgreSQL connection (Supabase direct connection or local install)
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Supabase project
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# JWT auth — generate long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Resend email (leave empty in dev — links are logged to the console instead)
RESEND_API_KEY=
MAIL_FROM="STIFF <onboarding@resend.dev>"

# First admin account, seeded on startup
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
