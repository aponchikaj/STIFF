# The game's admin panel — admin.stiff.co. Local dev runs on :3004.
#
# This is not the shop's panel. admin.stiff.ge runs the shop; this one runs
# the game and nothing else. They share one backend and one admin session:
# an admin is an ordinary shop account with role=admin, and the token minted
# at /api/admin/auth/login reaches /api/game/admin/* because those routes
# carry @Roles('admin').

# Local: Nest on this machine.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# The game itself — the player-facing site this panel operates.
# Defaults to http://localhost:3003 in dev, https://stiff.co in production.
# NEXT_PUBLIC_GAME_URL=http://localhost:3003

# Where hand-ins live: the R2 bucket the review screen loads a player's photo
# or clip from. Named in the CSP, so a wrong value shows nothing rather than
# an error. Defaults to https://media.stiff.ge.
# NEXT_PUBLIC_GAME_MEDIA_URL=https://media.stiff.ge

# Production / Vercel: keep API calls first-party through the Next.js rewrite
# so the session cookie stays first-party, and point the rewrite at Nest.
# This matters more here than on the shop panel: the panel is on stiff.co and
# the API is on stiff.ge, so without the rewrite every call is cross-site.
# NEXT_PUBLIC_API_URL=/api
# BACKEND_URL=https://stiff-i3nq.onrender.com
# NEXT_PUBLIC_GAME_URL=https://stiff.co
